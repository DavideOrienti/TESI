# Copia questo file in .env e compila i valori reali.
# NON inserire mai valori reali in questo file.

# Chiavi Flask / JWT (obbligatorie in produzione)
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Database (lascia vuoto per SQLite locale; in produzione usa PostgreSQL)
DATABASE_URL=

# TMDB API Key (gratuita su https://www.themoviedb.org/settings/api)
# Usata solo dalla pipeline offline (Fase_0). Non necessaria per la web app.
TMDB_API_KEY=your_tmdb_api_key_here

# Groq API Key (opzionale — necessaria per chat e spiegazioni LLM)
GROQ_API_KEY=your_groq_api_key_here

# URL del frontend (usato per il CORS; default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Chiave endpoint admin (opzionale; default insicuro se non impostata)
ADMIN_KEY=your_admin_key_here

# Impostare a "true" su Render (abilita SQLite in /tmp se DATABASE_URL è assente)
RENDER=

# Override del percorso base artefatti (opzionale)
APP_BASE_DIR=
